#!/usr/bin/env bash
# Surface: nvim. Writes lua/generated-theme.lua (fresh-start default).
# Deliberately no live RPC: relaunch nvim to apply (fast, predictable).
set -euo pipefail
THEME="${1:?usage: apply <theme> <dark|light>}"
MODE="${2:?usage: apply <theme> <dark|light>}"
ROOT="${THEME_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/theme}"
# shellcheck disable=SC1091
. "$ROOT/lib.sh"
FILE="$ROOT/themes/$THEME.toml"
NVIM_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/nvim"

CS="$(theme_val nvim "${MODE}_colorscheme" "$FILE")"
BG="$(theme_val nvim "${MODE}_background" "$FILE")"
[[ -n "$CS" && -n "$BG" ]] || { echo "nvim surface: missing [nvim] $MODE keys for $THEME" >&2; exit 1; }
# Optional raw lua (e.g. variant globals) executed before the colorscheme.
PRELUDE="$(theme_val nvim "${MODE}_prelude" "$FILE" || true)"

{
  printf -- '-- GENERATED by theme set (surface: nvim) — do not edit.\n'
  [[ -n "$PRELUDE" ]] && printf '%s\n' "$PRELUDE"
  printf 'return { colorscheme = "%s", background = "%s" }\n' "$CS" "$BG"
} > "$NVIM_DIR/lua/generated-theme.lua.tmp"
mv "$NVIM_DIR/lua/generated-theme.lua.tmp" "$NVIM_DIR/lua/generated-theme.lua"
