# Generated by the central theme command; edit the palette in ~/.config/theme.
[colors]
background = "${WORKSPACE_BG}"
backdrop = "${WORKSPACE_BG}"
accent_primary = "${ACCENT}"
shadow = "${SHADOW}"

[colors.border]
focused = "${ACCENT}"
unfocused = "#505050"

[colors.overview]
workspace_background = "${WORKSPACE_BG}"
badge = "${ACCENT}"

[input.cursor]
theme = "${CURSOR_THEME}"
